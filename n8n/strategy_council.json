{
  "name": "전략 자문 위원회 (멀티에이전트)",
  "nodes": [
    {
      "parameters": { "updates": ["message"], "additionalFields": {} },
      "id": "tg-trigger",
      "name": "텔레그램 입력",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [-560, 240],
      "credentials": { "telegramApi": { "id": "REPLACE_TELEGRAM_CRED_ID", "name": "Telegram 봇" } }
    },
    {
      "parameters": { "public": true, "options": { "responseMode": "lastNode" } },
      "id": "web-trigger",
      "name": "웹 채팅 입력",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [-560, 480],
      "webhookId": "strategy-council-chat"
    },

    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "n1", "name": "userMessage", "type": "string", "value": "={{ $json.message?.text ?? $json.chatInput }}" },
            { "id": "n2", "name": "sessionId", "type": "string", "value": "={{ String($json.message?.chat?.id ?? $json.sessionId) }}" },
            { "id": "n3", "name": "channel", "type": "string", "value": "={{ $json.message ? 'telegram' : 'web' }}" }
          ]
        },
        "options": {}
      },
      "id": "normalize",
      "name": "입력 정규화",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-300, 360]
    },

    {
      "parameters": { "model": "claude-sonnet-4-6", "options": {} },
      "id": "m1",
      "name": "위원1 모델 (Sonnet)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [-20, -260],
      "credentials": { "anthropicApi": { "id": "REPLACE_ANTHROPIC_CRED_ID", "name": "Anthropic account" } }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.userMessage }}",
        "options": { "systemMessage": "너는 '기획·구조화 위원'이다. 사용자의 아이디어/전략을 명확한 목표, 핵심 가설, 단계별 실행계획, 측정 가능한 KPI로 구조화한다. 모호한 것은 구체화하고 우선순위를 매겨라. 간결한 불릿으로 답하라." }
      },
      "id": "agent1",
      "name": "기획·구조화 위원",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [-20, -440]
    },

    {
      "parameters": { "model": "claude-sonnet-4-6", "options": {} },
      "id": "m2",
      "name": "위원2 모델 (Sonnet)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [-20, -20],
      "credentials": { "anthropicApi": { "id": "REPLACE_ANTHROPIC_CRED_ID", "name": "Anthropic account" } }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.userMessage }}",
        "options": { "systemMessage": "너는 '현실성 검수 위원'이자 악마의 변호인이다. 아이디어의 실현 가능성, 숨은 비용, 리스크, 실패 시나리오, 검증되지 않은 가정을 냉정하게 지적한다. 칭찬은 생략하고 약점과 그 완화책을 함께 제시하라." }
      },
      "id": "agent2",
      "name": "현실성 검수 위원",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [-20, -200]
    },

    {
      "parameters": { "model": "claude-sonnet-4-6", "options": {} },
      "id": "m3",
      "name": "위원3 모델 (Sonnet)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [-20, 220],
      "credentials": { "anthropicApi": { "id": "REPLACE_ANTHROPIC_CRED_ID", "name": "Anthropic account" } }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.userMessage }}",
        "options": { "systemMessage": "너는 '법률·규제 위원'이다. 공공조달·나라장터, 장애인기업/예비사회적기업 관련 법령, 계약·지식재산·개인정보 등 법적 쟁점을 식별한다. 확실치 않은 부분은 '확인 필요'로 명시하고, 이는 일반 정보일 뿐 공식 법률자문이 아님을 전제한다." }
      },
      "id": "agent3",
      "name": "법률·규제 위원",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [-20, 40]
    },

    {
      "parameters": { "model": "claude-sonnet-4-6", "options": {} },
      "id": "m4",
      "name": "위원4 모델 (Sonnet)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [-20, 500],
      "credentials": { "anthropicApi": { "id": "REPLACE_ANTHROPIC_CRED_ID", "name": "Anthropic account" } }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.userMessage }}",
        "options": { "systemMessage": "너는 '확장·디자인 위원'이다. 아이디어를 더 크게/멀리 보는 확장안, 시스템 구조, UX/제품 디자인, 다음 버전 로드맵을 제안한다. 창의적이되 다른 위원들이 지적할 현실 제약과 균형을 맞춰라." }
      },
      "id": "agent4",
      "name": "확장·디자인 위원",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [-20, 320]
    },

    {
      "parameters": { "model": "claude-sonnet-4-6", "options": {} },
      "id": "m5",
      "name": "위원5 모델 (Sonnet)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [-20, 780],
      "credentials": { "anthropicApi": { "id": "REPLACE_ANTHROPIC_CRED_ID", "name": "Anthropic account" } }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.userMessage }}",
        "options": { "systemMessage": "너는 '재무·투자 분석 위원'이다. 수익모델, 단위경제성(unit economics), 비용구조, 손익/현금흐름, 밸류에이션, 투자수익(ROI)을 분석한다. 주식·시장 리서치가 필요한 주제라면 재무지표·경쟁사·시장규모·리스크 관점에서 검토한다. 숫자와 가정을 명시하고 추정의 근거를 밝혀라. 이는 분석 정보일 뿐 투자 조언이 아님을 전제한다." }
      },
      "id": "agent5",
      "name": "재무·투자 분석 위원",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [-20, 600]
    },

    {
      "parameters": { "numberInputs": 5 },
      "id": "merge",
      "name": "의견 취합",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.1,
      "position": [320, 280]
    },
    {
      "parameters": { "aggregate": "aggregateAllItemData", "options": {} },
      "id": "aggregate",
      "name": "한 건으로 모으기",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [540, 280]
    },

    {
      "parameters": { "model": "claude-opus-4-8", "options": {} },
      "id": "synth-model",
      "name": "총괄 모델 (Opus)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [760, 480],
      "credentials": { "anthropicApi": { "id": "REPLACE_ANTHROPIC_CRED_ID", "name": "Anthropic account" } }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('입력 정규화').first().json.sessionId }}",
        "contextWindowLength": 20
      },
      "id": "synth-memory",
      "name": "대화 기억",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [900, 480]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=사용자 질문:\n{{ $('입력 정규화').first().json.userMessage }}\n\n--- 5인 위원 검토 의견 ---\n\n[기획·구조화]\n{{ $json.data[0].output }}\n\n[현실성 검수]\n{{ $json.data[1].output }}\n\n[법률·규제]\n{{ $json.data[2].output }}\n\n[확장·디자인]\n{{ $json.data[3].output }}\n\n[재무·투자 분석]\n{{ $json.data[4].output }}",
        "options": { "systemMessage": "너는 전략 자문 위원회의 '총괄'이다. 5인 위원(기획·구조화 / 현실성 검수 / 법률·규제 / 확장·디자인 / 재무·투자 분석)의 의견과 사용자의 원래 질문을 종합한다.\n\n다음 형식으로 답하라:\n1. 핵심 결론 (2~3줄)\n2. 합의점 / 쟁점(이견이 갈린 부분)\n3. 즉시 실행할 다음 액션 3가지\n4. 더 고민할 열린 질문\n\n대화체로, 사용자의 전략 파트너로서 답하라. 이전 대화 맥락을 기억해 이어서 코칭하라." }
      },
      "id": "synth",
      "name": "총괄 시너지 에이전트",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [760, 280]
    },

    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "arc1", "name": "archiveText", "type": "string", "value": "=전략 자문 아카이브\n일시: {{ $now.format('yyyy-LL-dd HH:mm') }}\n채널: {{ $('입력 정규화').first().json.channel }}\n\n[질문]\n{{ $('입력 정규화').first().json.userMessage }}\n\n[종합 결론]\n{{ $json.output }}\n\n[위원 의견]\n① 기획·구조화\n{{ $('한 건으로 모으기').first().json.data[0].output }}\n\n② 현실성 검수\n{{ $('한 건으로 모으기').first().json.data[1].output }}\n\n③ 법률·규제\n{{ $('한 건으로 모으기').first().json.data[2].output }}\n\n④ 확장·디자인\n{{ $('한 건으로 모으기').first().json.data[3].output }}\n\n⑤ 재무·투자 분석\n{{ $('한 건으로 모으기').first().json.data[4].output }}" }
          ]
        },
        "options": {}
      },
      "id": "archive-text",
      "name": "아카이브 본문",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1020, 120]
    },
    {
      "parameters": { "operation": "toText", "sourceProperty": "archiveText", "options": {} },
      "id": "to-file",
      "name": "파일 변환",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [1220, 120]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "inputDataFieldName": "data",
        "name": "={{ '전략아카이브_' + $now.format('yyyyLLdd_HHmmss') + '.txt' }}",
        "driveId": { "__rl": true, "mode": "list", "value": "My Drive" },
        "folderId": { "__rl": true, "mode": "id", "value": "REPLACE_DRIVE_FOLDER_ID" },
        "options": {}
      },
      "id": "drive",
      "name": "드라이브 아카이브",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1420, 120],
      "credentials": { "googleDriveOAuth2Api": { "id": "REPLACE_GDRIVE_CRED_ID", "name": "Google Drive account" } }
    },

    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $('입력 정규화').first().json.channel }}",
              "rightValue": "telegram",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "channel-if",
      "name": "채널 분기",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1020, 400]
    },
    {
      "parameters": {
        "chatId": "={{ $('입력 정규화').first().json.sessionId }}",
        "text": "={{ $json.output }}",
        "additionalFields": {}
      },
      "id": "tg-send",
      "name": "텔레그램 응답",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1280, 320],
      "credentials": { "telegramApi": { "id": "REPLACE_TELEGRAM_CRED_ID", "name": "Telegram 봇" } }
    },
    {
      "parameters": {},
      "id": "web-return",
      "name": "웹 반환",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1280, 500]
    }
  ],
  "connections": {
    "텔레그램 입력": { "main": [[{ "node": "입력 정규화", "type": "main", "index": 0 }]] },
    "웹 채팅 입력":   { "main": [[{ "node": "입력 정규화", "type": "main", "index": 0 }]] },

    "입력 정규화": {
      "main": [[
        { "node": "기획·구조화 위원", "type": "main", "index": 0 },
        { "node": "현실성 검수 위원", "type": "main", "index": 0 },
        { "node": "법률·규제 위원", "type": "main", "index": 0 },
        { "node": "확장·디자인 위원", "type": "main", "index": 0 },
        { "node": "재무·투자 분석 위원", "type": "main", "index": 0 }
      ]]
    },

    "위원1 모델 (Sonnet)": { "ai_languageModel": [[{ "node": "기획·구조화 위원", "type": "ai_languageModel", "index": 0 }]] },
    "위원2 모델 (Sonnet)": { "ai_languageModel": [[{ "node": "현실성 검수 위원", "type": "ai_languageModel", "index": 0 }]] },
    "위원3 모델 (Sonnet)": { "ai_languageModel": [[{ "node": "법률·규제 위원", "type": "ai_languageModel", "index": 0 }]] },
    "위원4 모델 (Sonnet)": { "ai_languageModel": [[{ "node": "확장·디자인 위원", "type": "ai_languageModel", "index": 0 }]] },
    "위원5 모델 (Sonnet)": { "ai_languageModel": [[{ "node": "재무·투자 분석 위원", "type": "ai_languageModel", "index": 0 }]] },

    "기획·구조화 위원":   { "main": [[{ "node": "의견 취합", "type": "main", "index": 0 }]] },
    "현실성 검수 위원":   { "main": [[{ "node": "의견 취합", "type": "main", "index": 1 }]] },
    "법률·규제 위원":     { "main": [[{ "node": "의견 취합", "type": "main", "index": 2 }]] },
    "확장·디자인 위원":   { "main": [[{ "node": "의견 취합", "type": "main", "index": 3 }]] },
    "재무·투자 분석 위원": { "main": [[{ "node": "의견 취합", "type": "main", "index": 4 }]] },

    "의견 취합": { "main": [[{ "node": "한 건으로 모으기", "type": "main", "index": 0 }]] },
    "한 건으로 모으기": { "main": [[{ "node": "총괄 시너지 에이전트", "type": "main", "index": 0 }]] },

    "총괄 모델 (Opus)": { "ai_languageModel": [[{ "node": "총괄 시너지 에이전트", "type": "ai_languageModel", "index": 0 }]] },
    "대화 기억":        { "ai_memory":        [[{ "node": "총괄 시너지 에이전트", "type": "ai_memory", "index": 0 }]] },

    "총괄 시너지 에이전트": {
      "main": [[
        { "node": "아카이브 본문", "type": "main", "index": 0 },
        { "node": "채널 분기", "type": "main", "index": 0 }
      ]]
    },

    "아카이브 본문": { "main": [[{ "node": "파일 변환", "type": "main", "index": 0 }]] },
    "파일 변환":     { "main": [[{ "node": "드라이브 아카이브", "type": "main", "index": 0 }]] },

    "채널 분기": {
      "main": [
        [{ "node": "텔레그램 응답", "type": "main", "index": 0 }],
        [{ "node": "웹 반환", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
