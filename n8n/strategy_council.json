{
  "name": "전략 자문 위원회 (사회자 선택 소집)",
  "nodes": [
    {
      "parameters": { "updates": ["message"], "additionalFields": {} },
      "id": "tg-trigger",
      "name": "텔레그램 입력",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [-720, 200],
      "credentials": { "telegramApi": { "id": "REPLACE_TELEGRAM_CRED_ID", "name": "Telegram 봇" } }
    },
    {
      "parameters": { "public": true, "options": { "responseMode": "lastNode" } },
      "id": "web-trigger",
      "name": "웹 채팅 입력",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [-720, 420],
      "webhookId": "strategy-council-chat"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "n1", "name": "userMessage", "type": "string", "value": "={{ $json.message?.text ?? $json.chatInput }}" },
            { "id": "n2", "name": "sessionId", "type": "string", "value": "={{ String($json.message?.chat?.id ?? $json.sessionId) }}" },
            { "id": "n3", "name": "channel", "type": "string", "value": "={{ $json.message ? 'telegram' : 'web' }}" }
          ]
        },
        "options": {}
      },
      "id": "normalize",
      "name": "입력 정규화",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-480, 300]
    },

    {
      "parameters": { "model": "claude-sonnet-4-6", "options": {} },
      "id": "facil-model",
      "name": "사회자 모델 (Sonnet)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [-240, 460],
      "credentials": { "anthropicApi": { "id": "REPLACE_ANTHROPIC_CRED_ID", "name": "Anthropic account" } }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"members\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\", \"enum\": [\"planning\", \"critic\", \"legal\", \"scale\", \"finance\", \"marketing\", \"admin\"] },\n      \"description\": \"소집할 위원 key 목록 (2~4명 권장)\"\n    },\n    \"reason\": { \"type\": \"string\", \"description\": \"소집 사유 한 줄\" }\n  },\n  \"required\": [\"members\"]\n}"
      },
      "id": "facil-parser",
      "name": "소집 명단 파서",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [-80, 460]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.userMessage }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "너는 전략 자문 위원회의 '사회자'다. 사용자 질문에 가장 도움이 될 위원 2~4명을 골라 소집한다. 관련 없는 위원은 부르지 마라. 단, 의사결정·실행 판단이 필요한 질문이면 critic을 포함하라.\n\n가용 위원:\n- planning : 기획·구조화 (목표·단계·KPI)\n- critic   : 현실성 검수 (리스크·실현가능성)\n- legal    : 법률·규제 (계약·지재권·개인정보·공공조달)\n- scale    : 확장·디자인 (시스템 구조·UX·로드맵)\n- finance  : 재무·투자 (수익모델·밸류에이션·주식/시장 리서치)\n- marketing: 마케팅 (타깃·포지셔닝·채널·브랜딩)\n- admin    : 조례·행정 고문 (지방 조례 제정·행정절차·자치분권)\n\nmembers 배열에 선택한 key만 담아 JSON으로 응답하라."
        }
      },
      "id": "facilitator",
      "name": "사회자",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [-160, 280]
    },

    {
      "parameters": {
        "jsCode": "const ROSTER = {\n  planning:  { role: `기획·구조화 위원`, systemPrompt: `너는 '기획·구조화 위원'이다. 아이디어를 목표·핵심가설·단계별 실행계획·측정가능한 KPI로 구조화하고 우선순위를 매겨라. 간결한 불릿으로 답하라.` },\n  critic:    { role: `현실성 검수 위원`, systemPrompt: `너는 '현실성 검수 위원'이자 악마의 변호인이다. 실현 가능성·숨은 비용·리스크·실패 시나리오·검증되지 않은 가정을 냉정하게 지적하고, 약점마다 완화책을 함께 제시하라.` },\n  legal:     { role: `법률·규제 위원`, systemPrompt: `너는 '법률·규제 위원'이다. 공공조달·계약·지식재산·개인정보 등 법적 쟁점을 식별한다. 불확실한 부분은 '확인 필요'로 표시하고, 일반 정보일 뿐 공식 법률자문이 아님을 전제한다.` },\n  scale:     { role: `확장·디자인 위원`, systemPrompt: `너는 '확장·디자인 위원'이다. 확장안·시스템 구조·UX/제품 디자인·다음 버전 로드맵을 제안한다. 창의적이되 현실 제약과 균형을 맞춰라.` },\n  finance:   { role: `재무·투자 분석 위원`, systemPrompt: `너는 '재무·투자 분석 위원'이다. 수익모델·단위경제성·비용구조·밸류에이션·ROI를 분석하고, 주식/시장 리서치 주제는 재무지표·경쟁사·시장규모·리스크 관점으로 본다. 숫자와 가정을 명시하라. 투자 조언이 아닌 분석 정보임을 전제한다.` },\n  marketing: { role: `마케팅 위원`, systemPrompt: `너는 숙련된 '마케팅 위원'이다. 타깃 고객·포지셔닝·핵심 메시지·채널 전략·브랜딩·성과지표(CAC·LTV·전환율)를 본다. 실행 가능한 캠페인 아이디어와 차별화 포인트를 제시하라.` },\n  admin:     { role: `조례·행정 고문`, systemPrompt: `너는 행정고시 출신의 '조례·행정 고문'이다. 지방자치 조례 제정·개정 절차, 상위법령 위임범위와 위법성 검토, 행정절차·예산·조직, 위원회 운영 전반을 자문한다. 지자체 자치분권·문화 조례 맥락을 고려하되, 불확실한 부분은 '확인 필요'로 표시하고 공식 법률자문이 아님을 전제한다.` }\n};\n\nconst data = $input.first().json;\nconst sel = (data.output && data.output.members) || [];\nconst userMessage = $('입력 정규화').first().json.userMessage;\n\nlet keys = sel.filter(function (k) { return ROSTER[k]; });\nif (keys.length === 0) keys = ['planning', 'critic'];\n\nreturn keys.map(function (k) {\n  return { json: { role: ROSTER[k].role, systemPrompt: ROSTER[k].systemPrompt, userMessage: userMessage } };\n});"
      },
      "id": "roster",
      "name": "명단 구성",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [120, 280]
    },

    {
      "parameters": { "model": "claude-sonnet-4-6", "options": {} },
      "id": "member-model",
      "name": "위원 모델 (Sonnet)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [340, 460],
      "credentials": { "anthropicApi": { "id": "REPLACE_ANTHROPIC_CRED_ID", "name": "Anthropic account" } }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.userMessage }}",
        "options": { "systemMessage": "={{ $json.systemPrompt }}" }
      },
      "id": "member-agent",
      "name": "위원 (소집된 만큼 반복)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [340, 280]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "l1", "name": "role", "type": "string", "value": "={{ $('명단 구성').item.json.role }}" },
            { "id": "l2", "name": "opinion", "type": "string", "value": "={{ $json.output }}" }
          ]
        },
        "options": {}
      },
      "id": "label",
      "name": "의견 라벨",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [560, 280]
    },
    {
      "parameters": { "aggregate": "aggregateAllItemData", "options": {} },
      "id": "aggregate",
      "name": "한 건으로 모으기",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [760, 280]
    },

    {
      "parameters": { "model": "claude-opus-4-8", "options": {} },
      "id": "synth-model",
      "name": "총괄 모델 (Opus)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [980, 480],
      "credentials": { "anthropicApi": { "id": "REPLACE_ANTHROPIC_CRED_ID", "name": "Anthropic account" } }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('입력 정규화').first().json.sessionId }}",
        "contextWindowLength": 20
      },
      "id": "synth-memory",
      "name": "대화 기억",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [1120, 480]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=사용자 질문:\n{{ $('입력 정규화').first().json.userMessage }}\n\n--- 소집된 위원 검토 의견 ---\n\n{{ $json.data.map(d => '[' + d.role + ']\\n' + d.opinion).join('\\n\\n') }}",
        "options": { "systemMessage": "너는 전략 자문 위원회의 '총괄'이다. 사회자가 소집한 위원들의 의견과 사용자의 원래 질문을 종합한다. (위원 수는 질문마다 다르다.)\n\n다음 형식으로 답하라:\n1. 핵심 결론 (2~3줄)\n2. 합의점 / 쟁점(이견이 갈린 부분)\n3. 즉시 실행할 다음 액션 3가지\n4. 더 고민할 열린 질문\n\n대화체로, 사용자의 전략 파트너로서 답하라. 이전 대화 맥락을 기억해 이어서 코칭하라." }
      },
      "id": "synth",
      "name": "총괄 시너지 에이전트",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [980, 280]
    },

    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "arc1", "name": "archiveText", "type": "string", "value": "=전략 자문 아카이브\n일시: {{ $now.format('yyyy-LL-dd HH:mm') }}\n채널: {{ $('입력 정규화').first().json.channel }}\n소집 위원: {{ $('한 건으로 모으기').first().json.data.map(d => d.role).join(', ') }}\n\n[질문]\n{{ $('입력 정규화').first().json.userMessage }}\n\n[종합 결론]\n{{ $json.output }}\n\n[위원 의견]\n{{ $('한 건으로 모으기').first().json.data.map(d => '[' + d.role + ']\\n' + d.opinion).join('\\n\\n') }}" }
          ]
        },
        "options": {}
      },
      "id": "archive-text",
      "name": "아카이브 본문",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1240, 120]
    },
    {
      "parameters": { "operation": "toText", "sourceProperty": "archiveText", "options": {} },
      "id": "to-file",
      "name": "파일 변환",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [1440, 120]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "inputDataFieldName": "data",
        "name": "={{ '전략아카이브_' + $now.format('yyyyLLdd_HHmmss') + '.txt' }}",
        "driveId": { "__rl": true, "mode": "list", "value": "My Drive" },
        "folderId": { "__rl": true, "mode": "id", "value": "REPLACE_DRIVE_FOLDER_ID" },
        "options": {}
      },
      "id": "drive",
      "name": "드라이브 아카이브",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1640, 120],
      "credentials": { "googleDriveOAuth2Api": { "id": "REPLACE_GDRIVE_CRED_ID", "name": "Google Drive account" } }
    },

    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose", "version": 2 },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $('입력 정규화').first().json.channel }}", "rightValue": "telegram", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "channel-if",
      "name": "채널 분기",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1240, 400]
    },
    {
      "parameters": {
        "chatId": "={{ $('입력 정규화').first().json.sessionId }}",
        "text": "={{ $json.output }}",
        "additionalFields": {}
      },
      "id": "tg-send",
      "name": "텔레그램 응답",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1500, 320],
      "credentials": { "telegramApi": { "id": "REPLACE_TELEGRAM_CRED_ID", "name": "Telegram 봇" } }
    },
    {
      "parameters": {},
      "id": "web-return",
      "name": "웹 반환",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1500, 500]
    }
  ],
  "connections": {
    "텔레그램 입력": { "main": [[{ "node": "입력 정규화", "type": "main", "index": 0 }]] },
    "웹 채팅 입력":   { "main": [[{ "node": "입력 정규화", "type": "main", "index": 0 }]] },

    "입력 정규화": { "main": [[{ "node": "사회자", "type": "main", "index": 0 }]] },

    "사회자 모델 (Sonnet)": { "ai_languageModel": [[{ "node": "사회자", "type": "ai_languageModel", "index": 0 }]] },
    "소집 명단 파서":       { "ai_outputParser":  [[{ "node": "사회자", "type": "ai_outputParser", "index": 0 }]] },

    "사회자": { "main": [[{ "node": "명단 구성", "type": "main", "index": 0 }]] },
    "명단 구성": { "main": [[{ "node": "위원 (소집된 만큼 반복)", "type": "main", "index": 0 }]] },

    "위원 모델 (Sonnet)": { "ai_languageModel": [[{ "node": "위원 (소집된 만큼 반복)", "type": "ai_languageModel", "index": 0 }]] },

    "위원 (소집된 만큼 반복)": { "main": [[{ "node": "의견 라벨", "type": "main", "index": 0 }]] },
    "의견 라벨": { "main": [[{ "node": "한 건으로 모으기", "type": "main", "index": 0 }]] },
    "한 건으로 모으기": { "main": [[{ "node": "총괄 시너지 에이전트", "type": "main", "index": 0 }]] },

    "총괄 모델 (Opus)": { "ai_languageModel": [[{ "node": "총괄 시너지 에이전트", "type": "ai_languageModel", "index": 0 }]] },
    "대화 기억":        { "ai_memory":        [[{ "node": "총괄 시너지 에이전트", "type": "ai_memory", "index": 0 }]] },

    "총괄 시너지 에이전트": {
      "main": [[
        { "node": "아카이브 본문", "type": "main", "index": 0 },
        { "node": "채널 분기", "type": "main", "index": 0 }
      ]]
    },

    "아카이브 본문": { "main": [[{ "node": "파일 변환", "type": "main", "index": 0 }]] },
    "파일 변환":     { "main": [[{ "node": "드라이브 아카이브", "type": "main", "index": 0 }]] },

    "채널 분기": {
      "main": [
        [{ "node": "텔레그램 응답", "type": "main", "index": 0 }],
        [{ "node": "웹 반환", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
