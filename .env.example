# 필수
ANTHROPIC_API_KEY=your_api_key_here
GMAIL_USER=your_gmail@gmail.com
GMAIL_PASSWORD=your_16_digit_app_password
NOTIFY_EMAIL=receiver@example.com

# 나라장터 입찰 자동화용 (run_collection.py)
NARA_API_KEY=your_data_go_kr_key

# 정부 AI/AX 지원사업 크롤러용 (run_gov_ai.py)
# 기업마당 오픈API 인증키 (주 소스, 사실상 필수).
# 발급: https://www.bizinfo.go.kr → 로그인 → 오픈API 신청
# 미설정 시 공개 데모키로 동작하지만 예고 없이 막힐 수 있다.
BIZINFO_API_KEY=your_bizinfo_crtfc_key
# K-Startup(보조, 선택) data.go.kr 서비스키.
# 주의: 서비스키는 신청한 서비스에만 유효하다. NARA_API_KEY 재사용 시 403.
GOV_DATA_API_KEY=your_data_go_kr_key

# 도매가 조회용 (선택)
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
